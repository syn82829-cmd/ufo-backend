generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionType {
  deposit
  withdraw
  case
  sale
}

enum CrashRoundStatus {
  waiting
  flying
  crashed
}

enum CrashBetStatus {
  active
  cashed_out
  lost
}

model User {
  id                         String          @id @default(uuid())
  telegram_id                BigInt          @unique
  username                   String?
  balance                    Int             @default(0)
  created_at                 DateTime        @default(now())

  cases_opened               Int             @default(0)
  crash_games                Int             @default(0)
  crash_wins                 Int             @default(0)

  bonus_channel_subscribed   Boolean         @default(false)
  bonus_friend_invited       Boolean         @default(false)
  daily_bonus_last_claim_at  DateTime?

  transactions               Transaction[]
  inventory                  InventoryItem[]
  crashBets                  CrashBet[]
}

model Transaction {
  id          String           @id @default(uuid())
  userId      String
  amount      Int
  type        TransactionType
  created_at  DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

model InventoryItem {
  id            String   @id @default(uuid())
  userId        String
  dropId        String
  dropName      String
  caseId        String
  priceStars    Int
  priceGems     String?
  png           String
  lottie        String?
  obtained_at   DateTime @default(now())
  isSold        Boolean  @default(false)
  sold_at       DateTime?

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([dropId])
  @@index([caseId])
}

model CrashRound {
  id                   String            @id @default(uuid())
  status               CrashRoundStatus  @default(waiting)

  round_number         Int               @unique

  countdown_started_at DateTime?
  flying_started_at    DateTime?
  crashed_at           DateTime?

  crash_point          Float?
  current_multiplier   Float             @default(1.0)

  is_settled           Boolean           @default(false)

  created_at           DateTime          @default(now())

  bets                 CrashBet[]

  @@index([status])
  @@index([created_at])
}

model CrashBet {
  id                 String          @id @default(uuid())
  roundId            String
  userId             String

  amount             Int
  status             CrashBetStatus  @default(active)

  cashout_multiplier Float?
  payout             Int?
  profit             Int?

  created_at         DateTime        @default(now())
  cashed_out_at      DateTime?

  round              CrashRound      @relation(fields: [roundId], references: [id])
  user               User            @relation(fields: [userId], references: [id])

  @@index([roundId])
  @@index([userId])
  @@index([status])
  @@unique([roundId, userId])
}
